# Life Explorer - Environment Variables Configuration

# 1. Database (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/life_explorer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/life_explorer

# 2. AI Service (Google Gemini)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Authentication & Security
AUTH_SECRET=your_32_char_random_auth_secret_here
ADMIN_PASSWORD=your_admin_password_here

# 4. Email Service (For sending verification codes)
# If omitted or not configured, verification codes will be logged to the server console in development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="Life Explorer <no-reply@example.com>"

# 5. Application Environment
NODE_ENV=development
PUBLIC_URL=http://localhost:8080
